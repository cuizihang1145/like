{
  "name": "lilkeu",
  "version": "0.0.1",
  "description": "一个配置简单轻量易用的小型无登录态无人机验证点赞系统",
  "main": "server.js",
  "exports": {
    ".": "./server.js",
    "./server": "./server.js",
    "./client": "./client.js"
  },
  "files": ["server.js", "client.js", "src", "types.d.ts"],
  "scripts": {
    "build": "esbuild src/backend/index.mjs --bundle --minify --outfile=server.js && esbuild src/frontend/index.js --bundle --minify --outfile=client.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.28.0",
    "pusher": "^5.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.19.0"
  },
  "keywords": ["likes", "microservice", "redis", "serverless"],
  "author": "cuizihang",
  "license": "MIT"
}